<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wm_bringup</name>
  <version>0.1.0</version>
  <description>Single entry point for Arena-Rosnav simulations of the wm_social_robot project: simulator, world, pedestrians and renderer selectable from the command line.</description>
  <maintainer email="noreply@example.com">wm_social_robot</maintainer>
  <license>MIT</license>

  <exec_depend>arena_bringup</exec_depend>
  <exec_depend>task_generator</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
